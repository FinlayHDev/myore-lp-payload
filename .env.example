# Public URL of the site, no trailing slash (used for share-image URLs)
SERVER_URL=http://localhost:3000

# Long random string used to sign admin sessions. Generate: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# SQLite file (relative to the project root). In Docker this lives on a volume.
DATABASE_URI=file:./data/payload.db

# Where uploaded media is stored
MEDIA_DIR=./media

# --- Email (optional; without SMTP_HOST, emails are printed to the server log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=hello@example.com
EMAIL_FROM_NAME=My Ore

# Optional: get an email each time someone joins the waitlist
WAITLIST_NOTIFY_EMAIL=
